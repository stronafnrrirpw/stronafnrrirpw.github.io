            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "justify"
            },
            ".card-title, .card-box": {
              "text-align": "center",
              "color": "#000000"
            },
            ".image-wrapper img": {
              "width": "100%"
