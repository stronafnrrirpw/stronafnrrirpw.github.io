                "padding": "0rem 2.25rem 2rem"
              },
              "@media (max-width: 767px)": {
                "padding": "0rem 1.5rem",
                "margin-bottom": "2rem"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "justify"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
