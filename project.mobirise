    "Pamietnik.html": {
      "settings": {
        "title": "Pamiętnik Luise von Liebermann z Dalkowa",
        "order": "9",
        "meta_descr": "Pamiętnik Luise von Liebermann z Dalkowa to zapiski dokonywane przez córkę właścicieli pałacu w Dalkowie na przestrzeni lat 1816-1823. Luise von Liebermann przedstawia życie na początku XIX – opisuje życie codzienne, sprawy dworskie, historie prywatne powiązane z mieszkańcami Dalkowa."
      },
