    "Europejskie-Drzewo-Roku-2025.html": {
      "settings": {
        "title": "Serce Wzgórz Dalkowskich Europejskim Drzewem Roku 2025",
        "order": "7",
        "meta_descr": "Buk pospolity odm. purpurowa to ok. 300-letni pomnik przyrody. Nazywany jest „Sercem Wzgórz Dalkowskich”. W 2024 r. drzewo to zdobyło w Polsce tytuł Drzewa Roku 2024 a rok później Europejskiego Drzewa Roku 2025 uzyskując 147 553 głosy internautów."
      },
