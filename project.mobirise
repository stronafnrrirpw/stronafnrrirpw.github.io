            "background-color": "@bgColor",
            ".mbr-text": {
              "color": "#000000",
              "text-align": "justify"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
